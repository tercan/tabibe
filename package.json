{
  "name": "tabibe",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "prepare:icons": "node scripts/build-brand-icons.mjs",
    "predev": "npm run prepare:icons",
    "dev": "vite",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prebuild": "npm run prepare:icons",
    "build": "vite build",
    "preview": "vite preview",
    "audit": "npm audit --audit-level=high",
    "budget:bundle": "node scripts/check-bundle.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "quality": "npm run lint && npm run lint:css && npm run format:check && npm run test && npm run build && npm run budget:bundle"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "simple-icons": "16.26.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
